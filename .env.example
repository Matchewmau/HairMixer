# ===========================================
# HairMixer Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit the actual .env file to version control!

# ================
# Django Settings
# ================
# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Set to 'false' in production
DJANGO_DEBUG=true

# Comma-separated list of allowed hosts
# For DigitalOcean App Platform, add your app URL (e.g., hairmixer-xxxxx.ondigitalocean.app)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ================
# CORS Settings
# ================
# Set to 'false' in production and specify allowed origins
CORS_ALLOW_ALL=true

# Comma-separated list of allowed origins (frontend URLs)
# For DigitalOcean, add your frontend app URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ================
# CSRF Settings  
# ================
# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ================
# Security Settings (Production)
# ================
# Enable HTTPS-only settings in production
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true  
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000

# ================
# Gemini AI Configuration
# ================
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model name for text generation
GEMINI_MODEL_NAME=gemini-2.0-flash

# For image generation overlay (optional, uses cookies from Gemini web)
# GEMINI_SECURE_1PSID=your-1psid-cookie
# GEMINI_SECURE_1PSIDTS=your-1psidts-cookie
OVERLAY_AI_ENABLED=true
GEMINI_TIMEOUT=120

# ================
# Face Classifier
# ================
FACE_CLASSIFIER_MODEL=resnet50
# Optional: specify custom model paths
# FACE_CLASSIFIER_RESNET_PATH=/path/to/resnet_weights.pth
# FACE_CLASSIFIER_MOBILENET_PATH=/path/to/mobilenet_weights.pth

# ================
# JWT Settings
# ================
# Optional: use a separate key for JWT signing
# JWT_SIGNING_KEY=your-jwt-signing-key

# ================
# Logging
# ================
DJANGO_LOG_LEVEL=INFO
# Set to 'true' for JSON-formatted logs (better for production log aggregation)
DJANGO_JSON_LOGS=false

# ================
# Rate Limiting
# ================
# Recommendation cache timeout in seconds
RECOMMENDATION_CACHE_TIMEOUT=3600
