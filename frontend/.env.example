# HairMixer Frontend Environment
# Copy this file to .env and update the values

# API URL - Update this to your backend URL
# For local development:
REACT_APP_API_URL=http://127.0.0.1:8000/api

# For DigitalOcean production, use your backend app URL:
# REACT_APP_API_URL=https://hairmixer-backend-xxxxx.ondigitalocean.app/api
